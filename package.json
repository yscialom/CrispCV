{
  "name": "crispcv",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "generate-registry": "node tools/generate-profile-registry.js",
    "generate-version": "node tools/generate-version.js",
    "start": "npm run generate-registry && npm run generate-version && ng serve",
    "build": "npm run generate-registry && npm run generate-version && ng build",
    "watch": "npm run generate-registry && npm run generate-version && ng build --watch --configuration development",
    "test": "npm run generate-registry && npm run generate-version && ng test",
    "lint": "ng lint",
    "format": "prettier --write \"./**/*.{js,json,ts,css,scss,less,html,md}\" | grep -v \"(unchanged)\" || true && stylelint \"./**/*.scss\" --fix"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "license": "GPL-2.0",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@fontsource/lato": "^5.0.0",
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@ngx-translate/core": "^16.0.0",
    "@ngx-translate/http-loader": "^16.0.0",
    "marked": "^17.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.0.0",
    "@angular-eslint/eslint-plugin": "^21.0.0",
    "@angular-eslint/eslint-plugin-template": "^21.0.0",
    "@angular-eslint/schematics": "^21.0.0",
    "@angular-eslint/template-parser": "^21.0.0",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/marked": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jsdom": "^27.1.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.2.4",
    "stylelint": "^16.2.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-scss": "^6.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
